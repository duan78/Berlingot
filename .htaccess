# ========================= L'Atelier Berlingot =========================
# Configuration Apache — redirections SEO + cache navigateur.

# Pas de listing des dossiers (ex. /assets/).
Options -Indexes

# UTF-8 par défaut sur tout le site.
AddDefaultCharset UTF-8

# ---- Redirections 301 : HTTPS + domaine sans www ----
<IfModule mod_rewrite.c>
    RewriteEngine On

    # HTTP -> HTTPS. La double condition évite toute boucle si le TLS
    # est terminé sur le proxy frontal (X-Forwarded-Proto: https).
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://latelierberlingot.com%{REQUEST_URI} [R=301,L]

    # www -> domaine principal (sans www).
    RewriteCond %{HTTP_HOST} ^www\. [NC]
    RewriteRule ^ https://latelierberlingot.com%{REQUEST_URI} [R=301,L]

    # /index.html -> / (évite la duplication de la page d'accueil).
    RewriteRule ^index\.html$ https://latelierberlingot.com/ [R=301,L]
</IfModule>

# ---- Cache navigateur (Core Web Vitals / visites répétées) ----
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>
